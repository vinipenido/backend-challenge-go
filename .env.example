# Valores locais de exemplo (sem segredos reais) para executar o serviço no host
# contra as dependências do docker compose (docker compose up -d postgres keycloak localstack).
APP_ENV=local
INSTANCE_ID=wallet-local
LOG_LEVEL=info
HTTP_ADDR=:8090
HTTP_REQUEST_TIMEOUT=10s

# Papel de aplicação (privilégios mínimos). Migrations usam MIGRATIONS_DATABASE_URL.
DATABASE_URL=postgres://wallet_app:wallet_app@localhost:5432/wallet?sslmode=disable
MIGRATIONS_DATABASE_URL=postgres://wallet_owner:wallet_owner@localhost:5432/wallet?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_LOCK_TIMEOUT=5s
DATABASE_STATEMENT_TIMEOUT=15s

# IdP (Keycloak). O emissor é sempre http://keycloak:8080/... (KC_HOSTNAME); as
# chaves são buscadas pelo host em localhost:8080.
OIDC_ISSUER_URL=http://keycloak:8080/realms/wagering
OIDC_JWKS_URL=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
OIDC_AUDIENCE=wallet-api
OIDC_PROVIDER_CLAIM=provider_id
OIDC_PROVIDER_ROLE=wagering-provider
OIDC_OPERATOR_ROLE=wallet-operator

# SQS (LocalStack). Credenciais locais de exemplo do papel "wallet-service".
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=wallet-service
AWS_SECRET_ACCESS_KEY=wallet-service-local-secret
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wallet-events.fifo
SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_TRUSTED_PROVIDERS=provider-a,provider-b
SQS_POLLERS=2
SQS_WAIT_TIME=5s
SQS_MAX_MESSAGES=10
SQS_VISIBILITY_TIMEOUT=30s
SQS_PROCESSING_TIMEOUT=15s
SQS_RETRY_BASE=2s
SQS_RETRY_MAX=60s

# Outbox
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE=30s
OUTBOX_RETRY_BASE=1s
OUTBOX_RETRY_MAX=5m

# Referências pendentes
PENDING_WORKER_ENABLED=true
PENDING_POLL_INTERVAL=500ms
PENDING_BATCH_SIZE=50
PENDING_REFERENCE_TTL=5m
PENDING_REFERENCE_MAX_ATTEMPTS=20
PENDING_BACKOFF_BASE=1s
PENDING_BACKOFF_MAX=30s

START_TIMEOUT=60s
SHUTDOWN_TIMEOUT=25s
